{
  "name": "@classhero-cli/classhero-ai-provider-openai",
  "version": "1.1.0",
  "private": true,
  "description": "OpenAI AIProvider plugin for the ClassHero CLI automator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch --preserveWatchOutput",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@classhero-cli/classhero-ai-automator": "workspace:*",
    "@classhero-cli/plugin-api": "workspace:*",
    "openai": "^7.12.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
