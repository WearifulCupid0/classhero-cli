{
  "name": "@classhero-cli/example-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Diagnostic example plugin used to validate the ClassHero CLI plugin API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch --preserveWatchOutput",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@classhero-cli/plugin-api": "workspace:*"
  }
}
